{
  "name": "nurearn-studio",
  "version": "1.2.0",
  "description": "Desktop app for TikTok LIVE events: chat, gifts, gift-triggered keyboard/sound/TTS actions, OBS overlay",
  "main": "main.js",
  "author": "You",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:icon": "node scripts/build-icon.js",
    "build": "node scripts/build-secure.js",
    "build:secure": "node scripts/build-secure.js",
    "build:win": "node scripts/build-secure.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@nut-tree-fork/nut-js": "^4.2.0",
    "cloudflared": "^0.7.3",
    "electron-extension-installer": "^1.2.0",
    "electron-store": "^8.2.0",
    "express": "^4.19.2",
    "firebase": "^12.19.0",
    "localtunnel": "^2.0.2",
    "msedge-tts": "^2.0.7",
    "node-machine-id": "^1.1.12",
    "play-dl": "^1.9.7",
    "say": "^0.16.0",
    "tiktok-live-connector": "^2.0.1",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "^24.13.3",
    "fs-extra": "^11.4.0",
    "javascript-obfuscator": "^5.7.0",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.nurearn.toolkit",
    "productName": "nurearn",
    "icon": "assets/icon.ico",
    "compression": "normal",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/*.dll",
      "**/*.exe",
      "**/cloudflared/**"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "overlay/**/*",
      "config/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "executableName": "nurearn",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "nurearn",
      "uninstallDisplayName": "nurearn Live Toolkit",
      "differentialPackage": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    }
  }
}
